{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-update",
  "version": "0.3.0",
  "identifier": "com.jingp.tauri-update",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-update",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBNzZBQjcwQzJCMENCNEYKUldSUHk3RENjS3QyK3JQN2xxUm9Yd1AyWWxoSitDMS94S0FheWFYM0VzbG94bmZpYmVmSlIxcDQK",
      "endpoints": [
        "https://github.com/jingpengju391/tauri-updater/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
